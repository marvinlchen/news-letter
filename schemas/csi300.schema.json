{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CSI300 Daily Analysis Report",
  "type": "object",
  "properties": {
    "date": {"type": "string"},
    "summary": {"type": "string"},
    "gainers_analysis": {
      "type": "object",
      "properties": {
        "sector_summary": {"type": "string"},
        "stocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {"type": "string"},
              "name": {"type": "string"},
              "reason": {"type": "string"},
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {"type": "string"},
                    "url": {"type": "string"}
                  }
                }
              }
            },
            "required": ["code", "name", "reason"]
          }
        }
      }
    },
    "losers_analysis": {
      "type": "object",
      "properties": {
        "sector_summary": {"type": "string"},
        "stocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {"type": "string"},
              "name": {"type": "string"},
              "reason": {"type": "string"},
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {"type": "string"},
                    "url": {"type": "string"}
                  }
                }
              }
            },
            "required": ["code", "name", "reason"]
          }
        }
      }
    }
  },
  "required": ["date", "summary", "gainers_analysis", "losers_analysis"]
}
