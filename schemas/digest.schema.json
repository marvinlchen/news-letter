{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "newsItem": {
      "type": "object",
      "properties": {
        "rank": {"type": "integer"},
        "title_zh": {
          "type": "string",
          "minLength": 4,
          "maxLength": 60
        },
        "title_original": {"type": "string"},
        "summary_zh": {
          "type": "string",
          "minLength": 60,
          "maxLength": 200
        },
        "category": {"type": "string"},
        "source": {"type": "string"},
        "published_at": {"type": "string"},
        "url": {"type": "string"},
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      },
      "required": [
        "rank",
        "title_zh",
        "title_original",
        "summary_zh",
        "category",
        "source",
        "published_at",
        "url",
        "confidence"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "date": {"type": "string"},
    "topics": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "macroeconomics",
              "shipping",
              "commodities",
              "stock_market",
              "technology",
              "consumer",
              "cloud_infra",
              "ai_frontier"
            ]
          },
          "name_zh": {"type": "string"},
          "items": {
            "type": "array",
            "maxItems": 3,
            "items": {"$ref": "#/definitions/newsItem"}
          }
        },
        "required": ["key", "name_zh", "items"],
        "additionalProperties": false
      }
    },
    "countries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": ["singapore", "china", "united_states"]
          },
          "name_zh": {"type": "string"},
          "items": {
            "type": "array",
            "maxItems": 3,
            "items": {"$ref": "#/definitions/newsItem"}
          }
        },
        "required": ["key", "name_zh", "items"],
        "additionalProperties": false
      }
    }
  },
  "required": ["date", "topics", "countries"],
  "additionalProperties": false
}
